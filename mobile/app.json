{
  "expo": {
    "name": "Hemen Pergola",
    "slug": "hemen-pergola",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "scheme": "hemenpergola",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.hemenpergola.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": ["tr", "en"]
      }
    },
    "android": {
      "package": "com.hemenpergola.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#162839"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#162839"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#162839",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f535d92-7343-4372-ba18-d82cc6a9b526"
      }
    },
    "owner": "enesaakkus"
  }
}
