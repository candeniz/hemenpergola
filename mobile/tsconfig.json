{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      // The contract surface, imported from the web's source tree rather than copied —
      // Phase 10's whole point was one schema per use case shared by every adapter, and a
      // fourth consumer that RETYPES the contract is drift with extra steps. Only PURE
      // modules may be aliased here (zod + domain constants, no 'server-only', no Prisma);
      // the api-surface report tracks which dto files qualify.
      "@contracts/*": ["../src/modules/*/application/dto"],
      // One message catalogue, two renderers (I18N-01). The mobile bundle carries the same
      // files next-intl serves; test/mobile-i18n.test.ts holds the keys together.
      "@messages/*": ["../src/i18n/messages/*"],
      // The consent-version constant (19 §Consent): the TEXT ships in the catalogues above;
      // the VERSION the service validates against must be the same constant, not a copy.
      "@legal/*": ["../src/shared/legal/*"],
      // TYPE RESOLUTION ONLY — never a runtime door. The dto files type-import across
      // modules with the web root alias (import type { X } from '@/…'); those imports are
      // erased before Metro exists, but tsc still follows them and must resolve the names.
      // mobile-boundary.test.ts holds the two guarantees that keep this safe: the runtime
      // map (contract-map.json) does NOT carry this key, and no file under mobile/ may
      // write an @/ import of its own.
      "@/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
