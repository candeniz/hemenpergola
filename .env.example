# Copy to .env and fill in. Every variable below without a "# optional" marker is
# required: the application refuses to start if one is missing or malformed
# (src/shared/config/env.ts, 23-deployment-and-environments.md §Configuration).
#
# The defaults match docker-compose.yml, so `docker compose up -d` and `pnpm dev`
# work together with no edits.

# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://pergola:pergola@localhost:5432/pergola?schema=public"
DIRECT_URL="postgresql://pergola:pergola@localhost:5432/pergola?schema=public"

# --- Auth --------------------------------------------------------------------
# At least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# --- Object storage (MinIO locally) ------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="pergola-local"
S3_ACCESS_KEY="pergola"
S3_SECRET_KEY="pergola-secret"
CDN_BASE_URL="http://localhost:9000/pergola-local"

# --- Mail --------------------------------------------------------------------
# log | resend | smtp. `log` writes to the console and needs no key; it is refused
# when APP_ENV=production.
MAIL_PROVIDER="log"
# MAIL_API_KEY=""            # optional with MAIL_PROVIDER=log, required otherwise
MAIL_FROM="no-reply@localhost"

# --- SMS ---------------------------------------------------------------------
# `log` is the development adapter (Q3 in 25-progress.md is still open).
SMS_PROVIDER="log"
# SMS_API_KEY=""             # optional with SMS_PROVIDER=log, required otherwise
# Alphanumeric sender ID, max 11 characters. Placeholder until Q1/Q3 close.
SMS_SENDER="PERGOLA"

# --- Geocoding ---------------------------------------------------------------
# GEOCODER_API_KEY=""        # optional; needed for radius service areas (Phase 3, Q4)

# --- Observability -----------------------------------------------------------
# SENTRY_DSN=""              # optional locally, required when APP_ENV is staging or production
LOG_LEVEL="debug"            # fatal | error | warn | info | debug | trace
APP_ENV="local"              # local | preview | staging | production

# --- Public (shipped to the browser — never put a secret here) ---------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
