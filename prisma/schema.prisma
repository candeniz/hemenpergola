// Implementation of `04-data-model.md`. That document is the contract; this file must not
// drift from it. Change the document first, then this schema, then a migration.
//
// Migration granularity: one migration per phase, named for it (ADR-014). This is
// migration 1 — Phase 0. It carries identity, tenancy, geography, the cross-cutting
// tables, and every deferred ADR-010 table. Catalogue, project, pricing, matching, offer,
// messaging, review and content tables arrive with their own phases.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — Postgres enums, except catalogue concepts which are rows (CAT-01).
// ─────────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Locale {
  tr
  en
}

enum CompanyRole {
  OWNER
  ADMIN
  SALES
  VIEWER
}

enum CompanyStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsentType {
  CONTACT_SHARING
  MARKETING
  TERMS
}

enum FileOwnerType {
  PROJECT
  COMPANY_DOCUMENT
  PORTFOLIO
  COMPANY_LOGO
  COMPANY_COVER
  CMS
  OFFER_ATTACHMENT
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

// Deferred (ADR-010) — the enums their tables need, so the tables are never touched again.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity and tenancy — 04 §Identity and tenancy
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  passwordHash    String?
  globalRole      GlobalRole @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  locale          Locale     @default(tr)
  fullName        String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  /// 12 §Abuse controls: progressive delay after 5 failed logins per account.
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockoutNotifiedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  memberships   CompanyMembership[]
  consents      Consent[]
  auditLogs     AuditLog[]          @relation("AuditActor")
  uploads       File[]              @relation("FileUploader")
  authTokens    AuthToken[]
  refreshTokens RefreshToken[]
  projects      Project[]
  // Phase 6 · migration 8
  offerRequests OfferRequest[]
  // Phase 5 · migration 7 — the zero-result subscription (5.7)
  notifications Notification[]

  @@index([deletedAt])
  @@index([globalRole, status])
}

// Auth.js v5 tables. Shapes are dictated by the adapter, not by 04.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id              String        @id @default(cuid())
  slug            String        @unique
  legalName       String
  /// Turkish sort order — 04 §Conventions. The cluster stays C.
  displayName     String
  taxNumber       String?
  about           String?
  logoId          String?
  coverId         String?
  status          CompanyStatus @default(PENDING)
  /// `ADR-006` item 4 and `PRC-06`: stay matchable without displaying a price. Not the same
  /// as having no price book — this is a deliberate choice, and the results page ranks it
  /// below priced companies rather than hiding it.
  priceOnRequest  Boolean       @default(false)
  verifiedAt      DateTime?
  rejectionReason String?
  foundedYear     Int?
  employeeRange   String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships   CompanyMembership[]
  documents     CompanyDocument[]
  contact       CompanyContact?
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  payments      Payment[]
  leadCredits   LeadCredit[]
  // Phase 3 · migration 4
  products      CompanyProduct[]
  serviceAreas  ServiceArea[]
  portfolio     PortfolioItem[]
  // Phase 3 · migration 5
  priceBooks    PriceBook[]
  calculations  PriceCalculation[]
  // Phase 5 · migration 7
  matchResults  MatchResult[]
  // Phase 6 · migration 8
  offerRequests OfferRequest[]
  disclosures   ContactDisclosure[]

  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_displayName_trgm")
  @@index([status])
  @@index([deletedAt])
}

model CompanyMembership {
  id         String      @id @default(cuid())
  userId     String
  companyId  String
  role       CompanyRole
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@index([userId])
}

model CompanyDocument {
  id         String         @id @default(cuid())
  companyId  String
  type       String
  fileId     String
  status     DocumentStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  note       String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])

  @@index([companyId, status])
  @@index([fileId])
}

model CompanyContact {
  id          String   @id @default(cuid())
  companyId   String   @unique
  phone       String?
  email       String?
  website     String?
  addressLine String?
  cityId      String?
  districtId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// PostGIS `geography(Point, 4326)`. Prisma has no native geography type, so this is
  /// `Unsupported`: it is created and indexed in migration SQL, and every read goes
  /// through `src/shared/geo` with `$queryRaw`. See 04 §PostGIS and Prisma.
  point Unsupported("geography(Point, 4326)")?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  city     City?     @relation(fields: [cityId], references: [id])
  district District? @relation(fields: [districtId], references: [id])

  @@index([point], type: Gist, map: "CompanyContact_point_gist")
  @@index([cityId])
  @@index([districtId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Geography — 04 §Matching and service areas. Seeded in task 0.5.
// ─────────────────────────────────────────────────────────────────────────────

model City {
  id        String   @id @default(cuid())
  /// Turkish sort order — 04 §Conventions.
  name      String
  plateCode Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  point Unsupported("geography(Point, 4326)")?

  districts                  District[]
  companyContacts            CompanyContact[]
  serviceAreas               ServiceArea[]
  portfolioItems             PortfolioItem[]
  priceBookRegionAdjustments PriceBookRegionAdjustment[]
  projects                   Project[]

  @@index([point], type: Gist, map: "City_point_gist")
  @@index([name])
}

model District {
  id        String   @id @default(cuid())
  cityId    String
  /// Turkish sort order — 04 §Conventions.
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  point Unsupported("geography(Point, 4326)")?

  city                       City                        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  companyContacts            CompanyContact[]
  serviceAreas               ServiceArea[]
  priceBookRegionAdjustments PriceBookRegionAdjustment[]
  projects                   Project[]

  @@unique([cityId, name])
  @@index([point], type: Gist, map: "District_point_gist")
  @@index([cityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cross-cutting — 04 §Messaging, reviews, media, content (the platform-wide tables)
// ─────────────────────────────────────────────────────────────────────────────

model File {
  id              String          @id @default(cuid())
  key             String          @unique
  bucket          String
  mime            String
  sizeBytes       Int
  width           Int?
  height          Int?
  ownerType       FileOwnerType
  ownerId         String
  uploadedBy      String?
  virusScanStatus VirusScanStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  uploader           User?               @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  companyDocuments   CompanyDocument[]
  seoOgImages        Seo[]
  // Phase 3 · migration 4
  portfolioPhotos    PortfolioPhoto[]
  variants           FileVariant[]
  projectAttachments ProjectAttachment[]

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
  @@index([virusScanStatus])
}

model Consent {
  id          String      @id @default(cuid())
  userId      String
  type        ConsentType
  /// The exact version of the text shown. 19 §Consent: consent is not a checkbox that
  /// vanishes after submit.
  textVersion String
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?
  ip          String
  userAgent   String

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerRequests OfferRequest[]
  disclosures   ContactDisclosure[]

  @@index([userId, type])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String
  companyId   String?
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  reason      String?
  ip          String
  userAgent   String
  createdAt   DateTime @default(now())

  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([companyId, createdAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Deferred — modelled, not built (ADR-010, ADR-014)
//
// No service, no route, no UI in V1. They ship here so later migrations are additive
// and nobody re-litigates the decision in Phase 7. Money is integer kuruş (ADR-005) —
// migration 1 is the only place money appears, and the rule is applied here once.
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  priceKurus Int
  interval   BillingInterval
  features   Json
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  companyId          String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([companyId, status])
  @@index([planId])
}

model Payment {
  id             String        @id @default(cuid())
  companyId      String
  subscriptionId String?
  amountKurus    Int
  status         PaymentStatus @default(PENDING)
  provider       String
  providerRef    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([subscriptionId])
}

model LeadCredit {
  id             String   @id @default(cuid())
  companyId      String
  delta          Int
  reason         String
  offerRequestId String?
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model ConfiguratorQuestion {
  id        String   @id @default(cuid())
  productId String
  key       String
  sortOrder Int      @default(0)
  payload   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ConfiguratorRule {
  id        String   @id @default(cuid())
  productId String
  kind      String
  payload   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 · Identity — migration 2 (ADR-014: one migration per phase)
// 12-authentication-authorization.md §Tokens, §Abuse controls
// ─────────────────────────────────────────────────────────────────────────────

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_OTP
}

/**
 * Verification and reset tokens. Separate from Auth.js's `VerificationToken`, which the
 * adapter owns and whose shape it dictates: this one is hashed at rest, typed, and counts
 * attempts, none of which that table does.
 * `tokenHash` is a SHA-256 of the token, never the token — a database dump must not be a
 * set of working password-reset links (19-security-and-kvkk.md §Logging).
 */
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int           @default(0)
  /// The phone or email the token was issued against, so a changed address invalidates it.
  target    String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/**
 * Refresh tokens for the `/api/v1` surface, stored hashed and grouped into families.
 * A family is one login. Rotation issues a new token in the same family and marks the old
 * one used; **replaying a used token revokes the entire family** (`12` §Tokens), because
 * the only way a used token is presented again is that someone else has a copy.
 */
model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  familyId      String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  /// Why the family died, when it did — `rotated`, `reuse_detected`, `logout`, `password_change`.
  revokedReason String?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
}

/**
 * Rate-limit counters — `06-api-specification.md` §Rate limits.
 * In Postgres, not in memory, and that is the only choice available: `23` runs the web tier
 * as *N* stateless instances behind a load balancer, so a per-process counter would give an
 * attacker N times the limit and would reset on every deploy. `05` §Jobs rules out Redis for
 * V1, which leaves the database that is already there.
 * One row per (bucket, window). The window start is truncated, so the row is found by an
 * upsert with no read-modify-write and no lock held across a round trip.
 */
model RateLimitHit {
  /// `surface:dimension:value` — e.g. `auth:ip:203.0.113.7`, `auth:account:a@b.com`.
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  @@id([bucket, windowStart])
  @@index([windowStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue — migration 3, Phase 2 (`ADR-014`: one migration per phase)
//
// `04-data-model.md` §Catalogue. Categories, products, attributes and options are
// **rows, not enums** (`CAT-01`), because `CAT-03` requires an admin to add a product
// and its options with no deployment. An enum would make every new product a migration.
//
// `CompanyProduct` / `CompanyProductOption` are deliberately absent: they are the
// manufacturer's offer over this catalogue and they arrive in Phase 3. The boundary is
// the point — this migration says what the platform sells, not who sells it.
// ─────────────────────────────────────────────────────────────────────────────

/// How a product is measured, which decides what the configurator asks for and what the
/// price book multiplies (`08-pricing-engine.md`).
enum ProductBasis {
  AREA_M2
  LENGTH_M
  UNIT
}

enum AttributeInputType {
  NUMBER
  SELECT
  MULTISELECT
  BOOL
  TEXT
}

/**
 * SEO metadata, attached to anything with a public URL (`18-cms-seo.md`).
 * A separate table rather than columns on each entity: the same six fields hang off
 * categories, products and CMS pages, and `18` treats them as one editable object in
 * `super_admin_cms_seo_management`.
 */
model Seo {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  noIndex         Boolean  @default(false)
  jsonLd          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ogImage    File?      @relation(fields: [ogImageId], references: [id], onDelete: SetNull)
  categories Category[]
  products   Product[]

  @@index([ogImageId])
}

model Category {
  id        String   @id @default(cuid())
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  seoId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  seo          Seo?                  @relation(fields: [seoId], references: [id], onDelete: SetNull)
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@index([seoId])
}

/**
 * The slug lives here, not on `Category` (`ADR-017`).
 * `07` §Route map: Turkish slugs are the canonical public URLs and `en` has its own set.
 * One slug per entity would put a Turkish word in every English canonical URL, which is
 * the thing `18-cms-seo.md` exists to prevent. Uniqueness is `(locale, slug)`, so a lookup
 * without a locale is not a lookup.
 */
model CategoryTranslation {
  categoryId  String
  locale      Locale
  slug        String
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@unique([locale, slug])
  @@index([slug])
}

model Product {
  id         String       @id @default(cuid())
  categoryId String
  basisType  ProductBasis
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  seoId      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  category        Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seo             Seo?                 @relation(fields: [seoId], references: [id], onDelete: SetNull)
  translations    ProductTranslation[]
  attributes      ProductAttribute[]
  companyProducts CompanyProduct[]
  portfolioItems  PortfolioItem[]
  priceBookItems  PriceBookItem[]
  projects        Project[]

  @@index([categoryId, sortOrder])
  @@index([isActive])
  @@index([seoId])
}

model ProductTranslation {
  productId        String
  locale           Locale
  slug             String
  name             String
  shortDescription String?
  description      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@unique([locale, slug])
  @@index([slug])
}

/**
 * One field in the configurator form (`10-project-configurator.md` §What V1 builds).
 * `showIfAttributeKey` + `showIfValue` are the **only** conditionality V1 has: one level,
 * no chaining, evaluated from the same rows on the client and the server. `ADR-008` declines
 * to build a rules engine and these two columns are what makes that affordable — without
 * them, "show the motor brand only when motorised is true" has no expression at all.
 * `04` §Catalogue omitted them; see the amendment on `ADR-008`.
 */
model ProductAttribute {
  id           String             @id @default(cuid())
  productId    String
  /// Stable machine key, referenced by `showIfAttributeKey` and by price books. Not
  /// translated, not shown to anyone.
  key          String
  inputType    AttributeInputType
  unit         String?
  min          Int?
  max          Int?
  step         Int?
  isRequired   Boolean            @default(false)
  /// Whether a change here can move the price. Drives which fields invalidate an estimate.
  affectsPrice Boolean            @default(false)
  sortOrder    Int                @default(0)

  /// One level of conditionality, by sibling `key` rather than by id: an attribute is
  /// authored before the one it depends on has an id, and a key is what an admin types.
  showIfAttributeKey String?
  showIfValue        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product       Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations  ProductAttributeTranslation[]
  projectValues ProjectAttributeValue[]
  options       ProductOption[]

  @@unique([productId, key])
  @@index([productId, sortOrder])
}

model ProductAttributeTranslation {
  attributeId String
  locale      Locale
  label       String
  helpText    String?

  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([attributeId, locale])
}

/**
 * A choice within a `SELECT` / `MULTISELECT` attribute.
 * **Never deleted once referenced — deactivated** (`10` §Admin authoring). A
 * `ProjectAttributeValue` from six months ago still points at it, and a
 * `PriceCalculation.breakdown` still names it; history has to stay readable. `onDelete:
 * Restrict` on those relations arrives with their phases, and `catalog-service` refuses the
 * delete today so the rule is enforced before there is anything to lose.
 */
model ProductOption {
  id          String   @id @default(cuid())
  attributeId String
  /// The stored value, e.g. `motorised`. Machine-readable; the label is translated.
  value       String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute             ProductAttribute           @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations          ProductOptionTranslation[]
  companyProductOptions CompanyProductOption[]
  priceBookOptionPrices PriceBookOptionPrice[]
  projectValues         ProjectAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
  @@index([isActive])
}

model ProductOptionTranslation {
  optionId String
  locale   Locale
  label    String

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
}

// ─────────────────────────────────────────────────────────────────────────────
// Manufacturer supply side — migration 4, Phase 3 (`ADR-014`)
//
// What a company offers and where it offers it: the catalogue rows it sells, the
// areas it covers, and the work it has done. `PriceBook*` is the second half of the
// phase and arrives in the same migration only if it lands in the same commit — it
// does not, so it comes with a fifth.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * A product this company sells (`04-data-model.md` §Catalogue).
 * The row is the company's *claim*, not a price. `09` §1 filters candidates on it: a
 * company that does not offer the product is not a candidate, and one that does not offer a
 * required option is not either. The filter is Phase 5; the shape has to be right here or
 * Phase 5 has nothing to filter on.
 */
model CompanyProduct {
  id        String   @id @default(cuid())
  companyId String
  productId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  options CompanyProductOption[]

  @@unique([companyId, productId])
  @@index([productId, isActive])
  @@index([companyId])
}

/**
 * Whether this company offers one option of one product.
 * A row means "we have an answer for this"; `isOffered = false` means "we do not do that".
 * The absence of a row means the company has never said either way, which `09` treats as
 * not offered — stated here because the two are easy to conflate and they rank differently.
 * `onDelete: Restrict` on the option is the database half of `10` §Admin authoring: an
 * option a manufacturer has answered cannot be deleted out from under them.
 */
model CompanyProductOption {
  id               String   @id @default(cuid())
  companyProductId String
  optionId         String
  isOffered        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companyProduct CompanyProduct @relation(fields: [companyProductId], references: [id], onDelete: Cascade)
  option         ProductOption  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([companyProductId, optionId])
  @@index([optionId, isOffered])
}

enum ServiceAreaKind {
  CITY
  DISTRICT
  RADIUS
}

/**
 * Where a company works — `09-manufacturer-matching.md` §Service-area coverage.
 * Three kinds, one table, because a company mixes them: "all of İzmir, plus Çeşme, plus
 * 40 km around the workshop" is one company's answer and three rows.
 * `centerPoint` is `Unsupported("geography")` and therefore invisible to the Prisma client
 * (`ADR-015`): it is written and read through `shared/geo`, and its GiST index is declared
 * here so `prisma migrate diff` stays empty.
 */
model ServiceArea {
  id          String                                 @id @default(cuid())
  companyId   String
  kind        ServiceAreaKind
  cityId      String?
  districtId  String?
  /// Only for `RADIUS`. Filled by the `geo.geocode_service_area` job.
  centerPoint Unsupported("geography(Point, 4326)")?
  radiusKm    Int?
  isActive    Boolean                                @default(true)
  /// What the manufacturer typed, kept so the centre can be recomputed if the geocoder
  /// behind the port ever gets better. Without it a re-geocode has nothing to work from.
  centerLabel String?
  /// How `centerPoint` was obtained — Q22, migration 7. The `Geocoder` port has computed
  /// this since `ADR-019` and the job used to discard it, leaving one end of every radius
  /// comparison unable to report its own accuracy. Null means "geocoded before this column
  /// existed" — unknown, not exact.
  precision   PointPrecision?
  createdAt   DateTime                               @default(now())
  updatedAt   DateTime                               @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  city     City?     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@index([companyId, isActive])
  @@index([kind, cityId])
  @@index([kind, districtId])
  @@index([centerPoint], type: Gist, map: "ServiceArea_centerPoint_gist")
}

/**
 * One completed job in a company's portfolio (`04` §Content and media).
 * `09` §Scoring reads the count per product as "portfolio depth", worth 5 of 100 — small,
 * but it is the only signal a brand-new company can move on its own in week one.
 */
model PortfolioItem {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  description String?
  productId   String?
  cityId      String?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  city    City?            @relation(fields: [cityId], references: [id], onDelete: SetNull)
  photos  PortfolioPhoto[]

  @@index([companyId, sortOrder])
  @@index([productId])
}

model PortfolioPhoto {
  id              String   @id @default(cuid())
  portfolioItemId String
  fileId          String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  item PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  file File          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, fileId])
  @@index([portfolioItemId, sortOrder])
  @@index([fileId])
}

/**
 * The rendered variants of one image — `14-file-storage-and-media.md` §Image pipeline.
 * A row per variant rather than a JSON column on `File`, because `next/image` needs a URL
 * per width and a JSON blob would have to be parsed on every render. `media.process` writes
 * them; re-running it upserts, which is what makes the job idempotent.
 */
model FileVariant {
  id        String @id @default(cuid())
  fileId    String
  /// `thumb` | `card` | `hero` | `full`, plus `hero-avif`.
  name      String
  key       String @unique
  width     Int
  height    Int
  mime      String
  sizeBytes Int

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, name])
  @@index([fileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pricing — migration 5, Phase 3 (`04-data-model.md` §Pricing, `08-pricing-engine.md`)
//
// A `PriceBook` in `PUBLISHED` is **immutable**. Editing means: clone to a new
// `DRAFT`, publish as `version + 1`, archive the old one. There is no update path
// on a published book, and the partial unique index below is what makes "one live
// book per company" true in the database rather than in a service comment.
// ─────────────────────────────────────────────────────────────────────────────

enum PriceBookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PriceUnit {
  PER_M2
  PER_M
  PER_UNIT
}

enum OptionPriceMode {
  FLAT
  PER_M2
  PER_M
  PER_UNIT
  PERCENT
}

/// `FLAT` is a kuruş amount, `PERCENT` a percentage of the stage it applies to.
enum AdjustmentMode {
  FLAT
  PERCENT
}

enum PriceRuleKind {
  AREA_DISCOUNT
  VALUE_DISCOUNT
  SIZE_SURCHARGE
  HEIGHT_SURCHARGE
}

model PriceBook {
  id          String          @id @default(cuid())
  companyId   String
  version     Int
  status      PriceBookStatus @default(DRAFT)
  publishedAt DateTime?
  publishedBy String?
  currency    String          @default("TRY")
  validFrom   DateTime?
  validTo     DateTime?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company      Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items        PriceBookItem[]
  optionPrices PriceBookOptionPrice[]
  adjustments  PriceBookRegionAdjustment[]
  rules        PriceBookRule[]
  calculations PriceCalculation[]

  @@unique([companyId, version])
  @@index([companyId, status])
}

model PriceBookItem {
  id                   String    @id @default(cuid())
  priceBookId          String
  productId            String
  basePriceKurus       Int
  unit                 PriceUnit
  minProjectPriceKurus Int       @default(0)
  setupFeeKurus        Int?

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([priceBookId, productId])
  @@index([productId])
}

model PriceBookOptionPrice {
  id          String          @id @default(cuid())
  priceBookId String
  optionId    String
  mode        OptionPriceMode
  valueKurus  Int?
  /// Stored as the percentage a human typed; the engine converts to basis points once.
  percent     Float?

  priceBook PriceBook     @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([priceBookId, optionId])
  @@index([optionId])
}

model PriceBookRegionAdjustment {
  id          String         @id @default(cuid())
  priceBookId String
  cityId      String?
  districtId  String?
  mode        AdjustmentMode
  valueKurus  Int?
  percent     Float?

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  city      City?     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  district  District? @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([priceBookId])
  @@index([cityId])
  @@index([districtId])
}

model PriceBookRule {
  id           String         @id @default(cuid())
  priceBookId  String
  kind         PriceRuleKind
  /// The window this rule fires in. The unit depends on the kind — m² or m for the size
  /// kinds, kuruş for `VALUE_DISCOUNT` — which is why the editor labels it per kind.
  thresholdMin Float?
  thresholdMax Float?
  mode         AdjustmentMode
  /// A **magnitude**. The sign comes from the kind: `*_DISCOUNT` subtracts, `*_SURCHARGE`
  /// adds. Signed values would let a discount typed as +500 become a surcharge.
  valueKurus   Int?
  percent      Float?
  note         String?

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@index([priceBookId, kind])
}

/**
 * Append-only (`PRC-02`). Never updated, never deleted by the application: republishing a
 * price book must not move an old estimate, which is the whole reason `priceBookVersion` and
 * `engineVersion` are columns rather than joins.
 * `actorUserId` and `requestIp` are here for `ADR-006`'s scraping detection — one actor
 * producing many calculations against one company across systematically varied dimensions.
 */
model PriceCalculation {
  id               String   @id @default(cuid())
  projectId        String?
  companyId        String
  priceBookId      String
  priceBookVersion Int
  netKurus         Int
  bandLowKurus     Int
  bandHighKurus    Int
  breakdown        Json
  engineVersion    Int
  calculatedAt     DateTime @default(now())
  actorUserId      String?
  requestIp        String?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceBook     PriceBook      @relation(fields: [priceBookId], references: [id], onDelete: Restrict)
  matchResults  MatchResult[]
  offerRequests OfferRequest[]

  @@index([companyId, calculatedAt])
  @@index([priceBookId])
  @@index([actorUserId, calculatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Matching — migration 7, Phase 5 (`04-data-model.md` §Matching and service areas,
// `09-manufacturer-matching.md`)
//
// A match run is **persisted, not cached**: revisiting the results page must not
// recompute, and "why was this company third" must be answerable months later
// (`09` §Explainability). `weightsVersion` pins which weight set produced the
// ranking, because the weights are `PlatformSetting` rows an admin can move.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Why a result has no band — `08` §Failure modes' three shapes, kept apart because the
 * customer reads them differently (5.8): `ON_REQUEST` is a company's choice or a book gap
 * ("ask them"), `UNAVAILABLE` is our engine failing ("try again shortly"). Collapsing them
 * would tell a customer to go ask a manufacturer for a price we failed to compute.
 */
enum MatchPriceState {
  PRICED
  ON_REQUEST
  UNAVAILABLE
}

model MatchRun {
  id             String   @id @default(cuid())
  projectId      String
  /// Which `matching.weights` set produced this ranking (`ADM-06`).
  weightsVersion Int
  resultCount    Int
  durationMs     Int
  createdAt      DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results MatchResult[]

  @@index([projectId, createdAt])
}

model MatchResult {
  id         String @id @default(cuid())
  matchRunId String
  companyId  String
  /// 0–100, the weighted sum `09` §Scoring defines. A float because components are
  /// normalised ratios — this is a ranking signal, not money (`ADR-005` does not apply).
  score      Float
  /// 1-based, the position after `ORDER BY priceOnRequest ASC, score DESC, distanceKm ASC,
  /// companyId ASC` — stored so the same run never reorders between page loads.
  rank       Int
  /// Every component's raw and weighted value (`09` §Explainability). Internal: the customer
  /// sees a sentence, the admin sees this.
  scoreBreakdown Json
  /// Null when the company could not be priced — which never removed it from the results
  /// (`08` §Failure modes, `PRC-06`).
  priceCalculationId String?
  priceOnRequest     Boolean @default(false)
  /// Refines `priceOnRequest` for display (5.8). `priceOnRequest` stays the ranking key.
  priceState MatchPriceState @default(ON_REQUEST)
  /// Company ↔ project, kilometres, from the eligibility query. Null when the company has
  /// no located point; nulls rank last within their tier.
  distanceKm Float?

  offerRequests    OfferRequest[]
  matchRun         MatchRun          @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceCalculation PriceCalculation? @relation(fields: [priceCalculationId], references: [id], onDelete: SetNull)

  @@unique([matchRunId, companyId])
  @@index([matchRunId, rank])
  @@index([companyId])
}

/**
 * `04` §Messaging's notification row, pulled forward by task 5.7: `09` §Zero-result handling
 * stores "notify me when a manufacturer covers my area" as a notification subscription. Only
 * the table 5.7 reads is built; `NotificationPreference` stays deferred with the rest of
 * Phase 7.
 */
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// e.g. `supply_gap_watch` — the zero-result subscription (`09` §Zero-result handling).
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Offer request lifecycle — migration 8, Phase 6 (`04-data-model.md` §Offer request
// lifecycle, `11-offer-request-lifecycle.md`)
//
// The state machine the whole product hangs on. Nothing writes `status` directly —
// every transition goes through `modules/offer/domain/state-machine.ts` (`CLAUDE.md`
// non-negotiable 4). The whole phase's tables ship in one migration (`ADR-014`);
// Appointment/Offer/OfferLine gain their services in the second half.
// ─────────────────────────────────────────────────────────────────────────────

enum OfferRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  SURVEY_SCHEDULED
  SURVEY_COMPLETED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_REJECTED
  WON
  LOST
  CLOSED
}

model OfferRequest {
  id         String             @id @default(cuid())
  projectId  String
  customerId String
  companyId  String
  status     OfferRequestStatus @default(PENDING)

  /// Which ranked result this request came from, when it came from one (`09`).
  matchResultId      String?
  /// The estimate the customer saw when they sent it (`PRC-02` makes it permanent).
  priceCalculationId String?

  /// `createdAt + PlatformSetting('offer_request.sla_hours')` — Q7's 48 h default.
  slaExpiresAt DateTime
  respondedAt  DateTime?

  declineReason String?
  /// Set exactly once, at PENDING → ACCEPTED, in the same transaction as the
  /// `ContactDisclosure` row (`11` §Contact disclosure).
  contactDisclosedAt DateTime?
  /// The CONTACT_SHARING consent captured at creation (`19` §Consent). Required: a request
  /// with no consent to disclose under must never exist.
  consentId    String
  closedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  customer         User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  consent          Consent           @relation(fields: [consentId], references: [id], onDelete: Restrict)
  matchResult      MatchResult?      @relation(fields: [matchResultId], references: [id], onDelete: SetNull)
  priceCalculation PriceCalculation? @relation(fields: [priceCalculationId], references: [id], onDelete: SetNull)
  disclosure       ContactDisclosure?
  appointments     Appointment[]
  offers           Offer[]

  /// One request per project per company — re-sending is a `CONFLICT`, not a duplicate.
  @@unique([projectId, companyId])
  @@index([companyId, status, slaExpiresAt])
  @@index([customerId, status])
  @@index([status, slaExpiresAt])
}

/**
 * `19` §Disclosure record. `offerRequestId` is UNIQUE — "exactly once" is a property of the
 * table, not only of the code path: a second acceptance racing the first cannot write a
 * second row even if every lock failed.
 */
model ContactDisclosure {
  id             String   @id @default(cuid())
  offerRequestId String   @unique
  companyId      String
  disclosedAt    DateTime @default(now())
  /// Exactly which fields were released (`19`: who, what, when, under which consent).
  disclosedFields String[]
  consentId       String

  offerRequest OfferRequest @relation(fields: [offerRequestId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  consent      Consent      @relation(fields: [consentId], references: [id], onDelete: Restrict)

  @@index([companyId, disclosedAt])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Appointment {
  id             String            @id @default(cuid())
  offerRequestId String
  scheduledAt    DateTime
  durationMin    Int               @default(60)
  status         AppointmentStatus @default(SCHEDULED)
  note           String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  offerRequest OfferRequest @relation(fields: [offerRequestId], references: [id], onDelete: Cascade)

  @@index([offerRequestId, scheduledAt])
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  /// A revised offer supersedes but never overwrites (`11` §Offers and KDV).
  SUPERSEDED
}

model Offer {
  id             String      @id @default(cuid())
  offerRequestId String
  /// Human-readable per-company sequence (`GSF-2026-0042`), unique platform-wide.
  number    String      @unique
  status    OfferStatus @default(DRAFT)
  netKurus  Int
  /// Basis points would be overkill: the KDV rate is a percentage with at most two
  /// decimals, stored as `Float` for display and applied once on the net total.
  taxRate    Float
  taxKurus   Int
  grossKurus Int
  validUntil DateTime
  note       String?
  sentAt     DateTime?
  decidedAt  DateTime?
  decisionNote String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  offerRequest OfferRequest @relation(fields: [offerRequestId], references: [id], onDelete: Restrict)
  lines        OfferLine[]

  @@index([offerRequestId, status])
}

model OfferLine {
  id            String @id @default(cuid())
  offerId       String
  sortOrder     Int    @default(0)
  description   String
  quantity      Float
  unit          String
  unitPriceKurus Int
  lineNetKurus   Int

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects — migration 6, Phase 4 (`04-data-model.md` §Project,
// `10-project-configurator.md`)
//
// The configurator's output: a project complete enough to match and price.
// Dimensions are **millimetres as integers**; `areaM2` is derived and stored for
// query and indexing only — the customer never types it (`10` §Field specifics).
//
// **Exactly one of `customerId` / `anonymousKey` is set.** Prisma cannot express
// that, so it is a CHECK constraint in the migration: the invariant is the
// difference between a draft that belongs to somebody and a draft that belongs to
// everybody.
// ─────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  READY
  SUBMITTED
  CLOSED
}

enum ProjectType {
  NEW_BUILD
  RENOVATION
}

enum InstallationType {
  WALL_MOUNTED
  FREESTANDING
  ROOF
  OTHER
}

enum ProjectTiming {
  ASAP
  M1_3
  M3_6
  PLANNING
}

/// How `Project.point` was obtained. Mirrors the `precision` the `Geocoder` port returns for
/// service areas (`ADR-019`), so both ends of a radius comparison describe their own accuracy
/// the same way — `09` §Explainability needs it to say the match was made on the district.
enum PointPrecision {
  EXACT
  DISTRICT
  CITY
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
}

model Project {
  id           String        @id @default(cuid())
  customerId   String?
  /// The anonymous draft's owner: an httpOnly cookie value, 30-day TTL (`10` §Anonymous
  /// drafts). Indexed because `POST /projects/{id}/claim` looks projects up by it.
  anonymousKey String?
  productId    String
  status       ProjectStatus @default(DRAFT)
  title        String?

  /// Outer-to-outer, millimetres, integers (`ADR-005`'s sibling rule for measurements:
  /// a float dimension is a rounding argument nobody can win).
  widthMm  Int?
  depthMm  Int?
  heightMm Int?
  /// Derived from `widthMm × depthMm`. Stored for query and indexing only.
  areaM2   Float?
  quantity Int    @default(1)

  projectType      ProjectType?
  installationType InstallationType?

  cityId         String?
  districtId     String?
  addressNote    String?
  point          Unsupported("geography(Point, 4326)")?
  /// Never null once `point` is set. Resolved at save time, not at match time: a null point
  /// makes `ST_DWithin` return NULL and GiST skip the row, so radius areas silently miss.
  pointPrecision PointPrecision?

  timing          ProjectTiming?
  budgetHintKurus Int?
  note            String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  customer    User?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  city        City?                   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  district    District?               @relation(fields: [districtId], references: [id], onDelete: SetNull)
  values        ProjectAttributeValue[]
  attachments   ProjectAttachment[]
  matchRuns     MatchRun[]
  offerRequests OfferRequest[]

  /// `04` §Indexes. The GiST index arrives with the table rather than with Phase 5's
  /// matching, because an index added later is an index somebody adds by hand in production.
  @@index([point], type: Gist, map: "Project_point_gist")
  @@index([customerId, status])
  @@index([anonymousKey])
  @@index([deletedAt])
}

/**
 * One answer to one attribute. The value column used depends on the attribute's
 * `inputType`; `optionId` is a reference rather than a copied label so a deactivated option
 * still renders (`10` §Admin authoring).
 */
model ProjectAttributeValue {
  id          String   @id @default(cuid())
  projectId   String
  attributeId String
  optionId    String?
  numberValue Float?
  boolValue   Boolean?
  textValue   String?

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  option    ProductOption?   @relation(fields: [optionId], references: [id], onDelete: Restrict)

  /// One answer per attribute. A `MULTISELECT` attribute is the exception and is modelled as
  /// several rows, so the constraint is on `(projectId, attributeId, optionId)`.
  @@unique([projectId, attributeId, optionId])
  @@index([projectId])
  @@index([attributeId])
}

/**
 * Task 4.6, second half. The table ships now so migration 6 is the whole phase.
 */
model ProjectAttachment {
  id        String         @id @default(cuid())
  projectId String
  fileId    String
  kind      AttachmentKind
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([projectId, fileId])
  @@index([projectId, sortOrder])
}
