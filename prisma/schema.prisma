// Implementation of `04-data-model.md`. That document is the contract; this file must not
// drift from it. Change the document first, then this schema, then a migration.
//
// Migration granularity: one migration per phase, named for it (ADR-014). This is
// migration 1 — Phase 0. It carries identity, tenancy, geography, the cross-cutting
// tables, and every deferred ADR-010 table. Catalogue, project, pricing, matching, offer,
// messaging, review and content tables arrive with their own phases.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — Postgres enums, except catalogue concepts which are rows (CAT-01).
// ─────────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Locale {
  tr
  en
}

enum CompanyRole {
  OWNER
  ADMIN
  SALES
  VIEWER
}

enum CompanyStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsentType {
  CONTACT_SHARING
  MARKETING
  TERMS
}

enum FileOwnerType {
  PROJECT
  COMPANY_DOCUMENT
  PORTFOLIO
  COMPANY_LOGO
  COMPANY_COVER
  CMS
  OFFER_ATTACHMENT
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

// Deferred (ADR-010) — the enums their tables need, so the tables are never touched again.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity and tenancy — 04 §Identity and tenancy
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  passwordHash    String?
  globalRole      GlobalRole @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  locale          Locale     @default(tr)
  fullName        String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  /// 12 §Abuse controls: progressive delay after 5 failed logins per account.
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockoutNotifiedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  memberships   CompanyMembership[]
  consents      Consent[]
  auditLogs     AuditLog[]          @relation("AuditActor")
  uploads       File[]              @relation("FileUploader")
  authTokens    AuthToken[]
  refreshTokens RefreshToken[]

  @@index([deletedAt])
  @@index([globalRole, status])
}

// Auth.js v5 tables. Shapes are dictated by the adapter, not by 04.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id              String        @id @default(cuid())
  slug            String        @unique
  legalName       String
  /// Turkish sort order — 04 §Conventions. The cluster stays C.
  displayName     String
  taxNumber       String?
  about           String?
  logoId          String?
  coverId         String?
  status          CompanyStatus @default(PENDING)
  verifiedAt      DateTime?
  rejectionReason String?
  foundedYear     Int?
  employeeRange   String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships   CompanyMembership[]
  documents     CompanyDocument[]
  contact       CompanyContact?
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  payments      Payment[]
  leadCredits   LeadCredit[]

  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_displayName_trgm")
  @@index([status])
  @@index([deletedAt])
}

model CompanyMembership {
  id         String      @id @default(cuid())
  userId     String
  companyId  String
  role       CompanyRole
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@index([userId])
}

model CompanyDocument {
  id         String         @id @default(cuid())
  companyId  String
  type       String
  fileId     String
  status     DocumentStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  note       String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])

  @@index([companyId, status])
  @@index([fileId])
}

model CompanyContact {
  id          String   @id @default(cuid())
  companyId   String   @unique
  phone       String?
  email       String?
  website     String?
  addressLine String?
  cityId      String?
  districtId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// PostGIS `geography(Point, 4326)`. Prisma has no native geography type, so this is
  /// `Unsupported`: it is created and indexed in migration SQL, and every read goes
  /// through `src/shared/geo` with `$queryRaw`. See 04 §PostGIS and Prisma.
  point Unsupported("geography(Point, 4326)")?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  city     City?     @relation(fields: [cityId], references: [id])
  district District? @relation(fields: [districtId], references: [id])

  @@index([point], type: Gist, map: "CompanyContact_point_gist")
  @@index([cityId])
  @@index([districtId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Geography — 04 §Matching and service areas. Seeded in task 0.5.
// ─────────────────────────────────────────────────────────────────────────────

model City {
  id        String   @id @default(cuid())
  /// Turkish sort order — 04 §Conventions.
  name      String
  plateCode Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  point Unsupported("geography(Point, 4326)")?

  districts       District[]
  companyContacts CompanyContact[]

  @@index([point], type: Gist, map: "City_point_gist")
  @@index([name])
}

model District {
  id        String   @id @default(cuid())
  cityId    String
  /// Turkish sort order — 04 §Conventions.
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  point Unsupported("geography(Point, 4326)")?

  city            City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  companyContacts CompanyContact[]

  @@unique([cityId, name])
  @@index([point], type: Gist, map: "District_point_gist")
  @@index([cityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cross-cutting — 04 §Messaging, reviews, media, content (the platform-wide tables)
// ─────────────────────────────────────────────────────────────────────────────

model File {
  id              String          @id @default(cuid())
  key             String          @unique
  bucket          String
  mime            String
  sizeBytes       Int
  width           Int?
  height          Int?
  ownerType       FileOwnerType
  ownerId         String
  uploadedBy      String?
  virusScanStatus VirusScanStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  uploader         User?             @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  companyDocuments CompanyDocument[]
  seoOgImages      Seo[]

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
  @@index([virusScanStatus])
}

model Consent {
  id          String      @id @default(cuid())
  userId      String
  type        ConsentType
  /// The exact version of the text shown. 19 §Consent: consent is not a checkbox that
  /// vanishes after submit.
  textVersion String
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?
  ip          String
  userAgent   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String
  companyId   String?
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  reason      String?
  ip          String
  userAgent   String
  createdAt   DateTime @default(now())

  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([companyId, createdAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Deferred — modelled, not built (ADR-010, ADR-014)
//
// No service, no route, no UI in V1. They ship here so later migrations are additive
// and nobody re-litigates the decision in Phase 7. Money is integer kuruş (ADR-005) —
// migration 1 is the only place money appears, and the rule is applied here once.
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  priceKurus Int
  interval   BillingInterval
  features   Json
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  companyId          String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([companyId, status])
  @@index([planId])
}

model Payment {
  id             String        @id @default(cuid())
  companyId      String
  subscriptionId String?
  amountKurus    Int
  status         PaymentStatus @default(PENDING)
  provider       String
  providerRef    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([subscriptionId])
}

model LeadCredit {
  id             String   @id @default(cuid())
  companyId      String
  delta          Int
  reason         String
  offerRequestId String?
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model ConfiguratorQuestion {
  id        String   @id @default(cuid())
  productId String
  key       String
  sortOrder Int      @default(0)
  payload   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ConfiguratorRule {
  id        String   @id @default(cuid())
  productId String
  kind      String
  payload   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 · Identity — migration 2 (ADR-014: one migration per phase)
// 12-authentication-authorization.md §Tokens, §Abuse controls
// ─────────────────────────────────────────────────────────────────────────────

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_OTP
}

/**
 * Verification and reset tokens. Separate from Auth.js's `VerificationToken`, which the
 * adapter owns and whose shape it dictates: this one is hashed at rest, typed, and counts
 * attempts, none of which that table does.
 * `tokenHash` is a SHA-256 of the token, never the token — a database dump must not be a
 * set of working password-reset links (19-security-and-kvkk.md §Logging).
 */
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int           @default(0)
  /// The phone or email the token was issued against, so a changed address invalidates it.
  target    String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/**
 * Refresh tokens for the `/api/v1` surface, stored hashed and grouped into families.
 * A family is one login. Rotation issues a new token in the same family and marks the old
 * one used; **replaying a used token revokes the entire family** (`12` §Tokens), because
 * the only way a used token is presented again is that someone else has a copy.
 */
model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  familyId      String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  /// Why the family died, when it did — `rotated`, `reuse_detected`, `logout`, `password_change`.
  revokedReason String?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
}

/**
 * Rate-limit counters — `06-api-specification.md` §Rate limits.
 * In Postgres, not in memory, and that is the only choice available: `23` runs the web tier
 * as *N* stateless instances behind a load balancer, so a per-process counter would give an
 * attacker N times the limit and would reset on every deploy. `05` §Jobs rules out Redis for
 * V1, which leaves the database that is already there.
 * One row per (bucket, window). The window start is truncated, so the row is found by an
 * upsert with no read-modify-write and no lock held across a round trip.
 */
model RateLimitHit {
  /// `surface:dimension:value` — e.g. `auth:ip:203.0.113.7`, `auth:account:a@b.com`.
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  @@id([bucket, windowStart])
  @@index([windowStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue — migration 3, Phase 2 (`ADR-014`: one migration per phase)
//
// `04-data-model.md` §Catalogue. Categories, products, attributes and options are
// **rows, not enums** (`CAT-01`), because `CAT-03` requires an admin to add a product
// and its options with no deployment. An enum would make every new product a migration.
//
// `CompanyProduct` / `CompanyProductOption` are deliberately absent: they are the
// manufacturer's offer over this catalogue and they arrive in Phase 3. The boundary is
// the point — this migration says what the platform sells, not who sells it.
// ─────────────────────────────────────────────────────────────────────────────

/// How a product is measured, which decides what the configurator asks for and what the
/// price book multiplies (`08-pricing-engine.md`).
enum ProductBasis {
  AREA_M2
  LENGTH_M
  UNIT
}

enum AttributeInputType {
  NUMBER
  SELECT
  MULTISELECT
  BOOL
  TEXT
}

/**
 * SEO metadata, attached to anything with a public URL (`18-cms-seo.md`).
 * A separate table rather than columns on each entity: the same six fields hang off
 * categories, products and CMS pages, and `18` treats them as one editable object in
 * `super_admin_cms_seo_management`.
 */
model Seo {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  noIndex         Boolean  @default(false)
  jsonLd          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ogImage    File?      @relation(fields: [ogImageId], references: [id], onDelete: SetNull)
  categories Category[]
  products   Product[]

  @@index([ogImageId])
}

model Category {
  id        String   @id @default(cuid())
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  seoId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  seo          Seo?                  @relation(fields: [seoId], references: [id], onDelete: SetNull)
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@index([seoId])
}

/**
 * The slug lives here, not on `Category` (`ADR-017`).
 * `07` §Route map: Turkish slugs are the canonical public URLs and `en` has its own set.
 * One slug per entity would put a Turkish word in every English canonical URL, which is
 * the thing `18-cms-seo.md` exists to prevent. Uniqueness is `(locale, slug)`, so a lookup
 * without a locale is not a lookup.
 */
model CategoryTranslation {
  categoryId  String
  locale      Locale
  slug        String
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@unique([locale, slug])
  @@index([slug])
}

model Product {
  id         String       @id @default(cuid())
  categoryId String
  basisType  ProductBasis
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  seoId      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seo          Seo?                 @relation(fields: [seoId], references: [id], onDelete: SetNull)
  translations ProductTranslation[]
  attributes   ProductAttribute[]

  @@index([categoryId, sortOrder])
  @@index([isActive])
  @@index([seoId])
}

model ProductTranslation {
  productId        String
  locale           Locale
  slug             String
  name             String
  shortDescription String?
  description      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@unique([locale, slug])
  @@index([slug])
}

/**
 * One field in the configurator form (`10-project-configurator.md` §What V1 builds).
 * `showIfAttributeKey` + `showIfValue` are the **only** conditionality V1 has: one level,
 * no chaining, evaluated from the same rows on the client and the server. `ADR-008` declines
 * to build a rules engine and these two columns are what makes that affordable — without
 * them, "show the motor brand only when motorised is true" has no expression at all.
 * `04` §Catalogue omitted them; see the amendment on `ADR-008`.
 */
model ProductAttribute {
  id           String             @id @default(cuid())
  productId    String
  /// Stable machine key, referenced by `showIfAttributeKey` and by price books. Not
  /// translated, not shown to anyone.
  key          String
  inputType    AttributeInputType
  unit         String?
  min          Int?
  max          Int?
  step         Int?
  isRequired   Boolean            @default(false)
  /// Whether a change here can move the price. Drives which fields invalidate an estimate.
  affectsPrice Boolean            @default(false)
  sortOrder    Int                @default(0)

  /// One level of conditionality, by sibling `key` rather than by id: an attribute is
  /// authored before the one it depends on has an id, and a key is what an admin types.
  showIfAttributeKey String?
  showIfValue        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductAttributeTranslation[]
  options      ProductOption[]

  @@unique([productId, key])
  @@index([productId, sortOrder])
}

model ProductAttributeTranslation {
  attributeId String
  locale      Locale
  label       String
  helpText    String?

  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([attributeId, locale])
}

/**
 * A choice within a `SELECT` / `MULTISELECT` attribute.
 * **Never deleted once referenced — deactivated** (`10` §Admin authoring). A
 * `ProjectAttributeValue` from six months ago still points at it, and a
 * `PriceCalculation.breakdown` still names it; history has to stay readable. `onDelete:
 * Restrict` on those relations arrives with their phases, and `catalog-service` refuses the
 * delete today so the rule is enforced before there is anything to lose.
 */
model ProductOption {
  id          String   @id @default(cuid())
  attributeId String
  /// The stored value, e.g. `motorised`. Machine-readable; the label is translated.
  value       String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute    ProductAttribute           @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations ProductOptionTranslation[]

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
  @@index([isActive])
}

model ProductOptionTranslation {
  optionId String
  locale   Locale
  label    String

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
}
