{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // `test/mobile-session-network.test.ts` imports the mobile API client, which imports
      // the contract surface through the alias `mobile/tsconfig.json` defines. `exclude`
      // does not stop tsc following an import, so the root project has to resolve the same
      // name — the SAME mapping `mobile/contract-map.json` carries, which
      // `mobile-boundary.test.ts` holds all three copies to.
      "@contracts/*": ["./src/modules/*/application/dto"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "*.config.ts",
    "*.config.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "mobile",
    "Frontend Tasarım",
    "Yazılım Mimari Promptlar",
    "test/fixtures/boundary"
  ]
}
